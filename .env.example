# ==============================================================================
# RSS AI 部署环境配置文件模板 (Environment Configuration Template)
# 使用说明: 复制本文件为 .env，并修改其中的密码与 API 密钥即可
# ==============================================================================

# 时区配置
TZ=Asia/Shanghai

# 服务器 IP 或域名 (用于阅读器与外链跳转，本地部署可填局域网 IP 或 localhost)
HOST_IP=127.0.0.1
BIND_IP=0.0.0.0

# 外部映射访问端口
PORT_MINIFLUX=18080
PORT_REACTFLUX=13000
PORT_AI_CONSOLE=18090
PORT_IMAGE_PROXY=18091

# PostgreSQL 数据库凭据
POSTGRES_DB=miniflux
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Miniflux 管理员账户与初始密码
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=your_secure_admin_password_here

# 大模型 API 配置 (支持 OpenAI、DeepSeek、Ollama、OneAPI 等 OpenAI 兼容接口)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk-your-llm-api-key-here
AI_MODEL=gpt-4o-mini

# Miniflux 与 AI Worker 之间的 Webhook 签名密钥 (可使用 openssl rand -hex 16 生成)
AI_WEBHOOK_SECRET=your_random_hex_secret_here

# 图片防盗链代理私钥
MEDIA_PROXY_PRIVATE_KEY=your_media_proxy_private_key_here
