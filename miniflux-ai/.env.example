# ============================================================
# RSS AI Worker 环境变量模板
# 复制为 .env 并填写真实值。切勿提交真实 .env 到版本库。
# ============================================================

# --- 时区 ---
TZ=Asia/Shanghai

# --- 局域网绑定地址（服务暴露的宿主机 IP） ---
LAN_IP=127.0.0.1

# --- Miniflux 管理员（同时用于 AI Worker 控制台 Basic Auth） ---
MINIFLUX_ADMIN_USER=admin
MINIFLUX_ADMIN_PASSWORD=change-me-strong-password

# --- Miniflux / PostgreSQL 版本（建议固定 digest） ---
MINIFLUX_VERSION=2.3.3
POSTGRES_VERSION=17-alpine

# --- PostgreSQL 凭据 ---
POSTGRES_USER=miniflux
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=miniflux

# --- LLM（OpenAI 兼容端点） ---
AI_BASE_URL=https://your-llm-endpoint/v1
AI_API_KEY=sk-your-api-key
AI_MODEL=auto

# --- Miniflux Webhook 密钥（AI Worker 与 Miniflux 集成） ---
AI_WEBHOOK_SECRET=change-me-webhook-secret

# --- Miniflux 媒体代理私钥（MEDIA_PROXY_PRIVATE_KEY，用于图片代理签名） ---
# 生成：openssl rand -base64 32
MEDIA_PROXY_PRIVATE_KEY=change-me-media-proxy-key
